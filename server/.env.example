PORT=5000
CLIENT_URL=http://localhost:5173
# MongoDB Atlas connection string (include the database name after .mongodb.net/)
MONGO_URI=

# JWT: long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gemini (free tier) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

# Skill matcher thresholds (provisional — set from `npm run eval:matcher`)
MATCH_HIGH=0.95
MATCH_LOW=0.80

# Admin account created by: npm run seed:admin
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
